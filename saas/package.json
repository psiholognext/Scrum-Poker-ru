    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "@wasp.sh/spec": "file:.wasp/spec",
    "typescript": "6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "prisma": "5.19.1"
  },
  "overrides": {
    "nodemailer": "^10.3.1"
